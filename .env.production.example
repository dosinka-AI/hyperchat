# HyperChat full-alpha runtime configuration.
# Copy to .env.production (gitignored) and fill in real values:
#
#   cp .env.production.example .env.production
#
# docker compose reads this file automatically (env_file).

# Signs every login session. REQUIRED for a real deployment - unset, the
# app runs on the shared development signing key and logs a loud warning
# on every boot. Generate one:  openssl rand -hex 32
JWT_SECRET=

# Shared secret between the web app and the realtime sidecar's control API
# (localhost-only, never leaves the container). Generate one:
#   openssl rand -hex 24
INTERNAL_TOKEN=

# Empty = plain-HTTP mode (fine for testing over an IP; note that browsers
# gate the microphone behind HTTPS, so voice calls need a domain). Set to
# your domain, e.g. SITE_ADDRESS=alpha.example.com, to get automatic HTTPS
# with a real Let's Encrypt certificate.
SITE_ADDRESS=

# Cherry-picked alpha mode: on the first boot of an empty database, seed
# three fixed-credential tester accounts - tester1 / tester2 / tester3,
# password "hyperion-alpha" - so the server is usable the moment it is up.
# quickstart.sh and fly.sh turn this on by default; remove the line (or
# leave unset) for a clean slate where you register real accounts.
SEED_DEMO=true

# TURN relay for voice/video behind symmetric NATs (optional but recommended
# for production: STUN alone cannot punch through symmetric NATs, and calls
# there connect but carry no audio). Point NEXT_PUBLIC_TURN_URL at your coturn
# instance, e.g. turn:turn.example.com:3478 (comma-separate several). Without
# a username the relay is treated as open; with one, pass its credential.
# See DEPLOY.md "honest limits" for a minimal coturn config.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ── big storage (optional, the 4TB-drive setup) ─────────────────────
# The vault (chunked ephemeral file sends) and legacy uploads live in
# folders inside the app by default. To keep them on a big external
# drive, mount it and point both at subdirectories of the mount:
#   VAULT_DIR=/mnt/hyperdrive/vault
#   UPLOAD_DIR=/mnt/hyperdrive/uploads
# (UPLOADS_DIR is the older spelling of UPLOAD_DIR — both work.)
# New files land on the drive immediately; no migration step is needed.
# VAULT_BUDGET_BYTES: how full the vault may get (default 400 GiB — the
# vault is one tenant on the drive). As it fills, file lifetimes shrink
# automatically (down to a 10-minute floor) so the disk never wedges.
# VAULT_DAILY_USER_BYTES: per-user daily upload budget (default 8 GiB).
VAULT_DIR=
UPLOAD_DIR=
VAULT_BUDGET_BYTES=
VAULT_DAILY_USER_BYTES=

# VirusTotal scanning of finished uploads (optional). Without a key the
# app is honest about it: no scan happens, no "scanned" chip is shown.
# With a key, every upload <= 32 MB is submitted once and polled; a
# positive verdict blocks the download for everyone (delete stays
# uploader-only). Free key: https://www.virustotal.com/gui/join-us
VIRUSTOTALE_API_KEY=
